# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Umschalten auf ein Release-Artefakt (deploy/rollout, ADR-034)
/.next.neu/
/.next.alt/
/out/
# both.money (apps/wallet)
apps/*/.next/
apps/*/.next.neu/
apps/*/.next.alt/
apps/*/next-env.d.ts

# production
/build
# gebündelter Parser-Prozess (pnpm build:parser)
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: ignore everything except the example template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# security / test artefacts
sbom.cdx.json
/playwright-report/
/test-results/

# Playwright
test-results/
playwright-report/

# taste-skill Arbeitsdateien (.claude/skills/design-taste-frontend)
.taste-skill/
