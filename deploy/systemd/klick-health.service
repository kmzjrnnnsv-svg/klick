# /etc/systemd/system/klick-health.service — Zustand des Servers prüfen (Härtung H9)
# Platte, Zertifikate, Dienste, auditd, nftables, CrowdSec, Neustart.
# Skript liegt root-eigen unter /usr/local/lib/klick-health/ (nicht im
# App-Checkout, den der App-User beschreiben kann):
#   install -D -m 0755 -o root -g root scripts/host-health.sh /usr/local/lib/klick-health/host-health.sh
[Unit]
Description=Klick — Zustand des Servers prüfen
OnFailure=klick-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/klick-health/host-health.sh
# root: liest Zertifikate, Audit-Status, nftables und CrowdSec; ändert nichts
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_AUDIT_CONTROL
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
