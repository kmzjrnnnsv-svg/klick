# /etc/systemd/system/both-sanctions.service — OFAC-Sperradressen für
# both.money täglich neu laden (pnpm wallet:sanctions --fetch). Eine leere
# oder kaputte Liste bricht ab, ohne die bestehende zu leeren; Ergebnis im
# Plattform-Protokoll von both.money.
[Unit]
Description=both.money — Sanktionsliste (OFAC-Adressen) aktualisieren
After=postgresql.service network-online.target
Wants=network-online.target
OnFailure=klick-alert@%n.service

[Service]
Type=oneshot
User=both
Group=both
WorkingDirectory=/opt/both/current
EnvironmentFile=-/etc/both/both.env
Environment=HOME=/opt/both
LoadCredentialEncrypted=wallet_database_url:/etc/credstore.encrypted/wallet_database_url
LoadCredentialEncrypted=wallet_vault_kek_base64:/etc/credstore.encrypted/wallet_vault_kek_base64
LoadCredentialEncrypted=wallet_auth_secret:/etc/credstore.encrypted/wallet_auth_secret
ExecStart=/bin/sh -c 'export WALLET_DATABASE_URL="$(cat "$CREDENTIALS_DIRECTORY/wallet_database_url")" WALLET_VAULT_KEK_BASE64="$(cat "$CREDENTIALS_DIRECTORY/wallet_vault_kek_base64")" WALLET_AUTH_SECRET="$(cat "$CREDENTIALS_DIRECTORY/wallet_auth_secret")" WALLET_AUTH_URL=https://both.money; exec /usr/local/bin/pnpm wallet:sanctions --fetch'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
UMask=0077
# Die Apps sehen einander nicht (gleicher Server, Härtung H5)
InaccessiblePaths=-/opt/klick -/etc/klick -/var/log/klick -/var/lib/klick-signer -/var/backups -/var/lib/klick-backup -/root
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/opt/both/.cache
