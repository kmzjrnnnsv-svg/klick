# /etc/systemd/system/both.service.d/nodes.conf — eigene Knoten für both.money.
# Eigener rpcauth-User am Knoten (nicht der von Klick); die URL enthält die
# Zugangsdaten und liegt deshalb verschlüsselt als Credential vor:
#   printf %s 'http://both:…@10.8.0.2:38332' | systemd-creds encrypt \
#     --name=both_rpc_bitcoin_signet - /etc/credstore.encrypted/both_rpc_bitcoin_signet
# both-start.sh exportiert sie als WALLET_RPC_BITCOIN_SIGNET usw.
[Service]
LoadCredentialEncrypted=both_rpc_bitcoin_signet:/etc/credstore.encrypted/both_rpc_bitcoin_signet
LoadCredentialEncrypted=both_rpc_ethereum_sepolia:/etc/credstore.encrypted/both_rpc_ethereum_sepolia
