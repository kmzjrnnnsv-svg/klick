# /etc/systemd/system/klick-signer-admin.socket — Signer, Socket für root
#
# Nur root am Terminal (`pnpm signer:admin`): einrichten (Seeds, Wörter),
# Sicherheitsschlüssel-Links, sperren, Richtlinie setzen, auftauen, rekey.
[Unit]
Description=Klick — Signer (admin.sock, nur root)

[Socket]
ListenStream=/run/klick-signer/admin.sock
FileDescriptorName=admin
Service=klick-signer.service
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
