# /etc/systemd/system/klick-sanctions.service — OFAC-Sperradressen täglich
# neu laden (pnpm wallet:sanctions --fetch). Eine leere oder kaputte Liste
# bricht ab, ohne die bestehende zu leeren; Ergebnis im Plattform-Audit.
[Unit]
Description=Klick — Sanktionsliste (OFAC-Adressen) aktualisieren
After=postgresql.service network-online.target
Wants=network-online.target
OnFailure=klick-alert@%n.service

[Service]
Type=oneshot
User=klick
Group=klick
WorkingDirectory=/opt/klick/current
EnvironmentFile=/etc/klick/klick.env
Environment=HOME=/opt/klick
LoadCredentialEncrypted=database_url:/etc/credstore.encrypted/database_url
LoadCredentialEncrypted=vault_kek_base64:/etc/credstore.encrypted/vault_kek_base64
LoadCredentialEncrypted=better_auth_secret:/etc/credstore.encrypted/better_auth_secret
ExecStart=/bin/sh -c 'export DATABASE_URL="$(cat "$CREDENTIALS_DIRECTORY/database_url")" VAULT_KEK_BASE64="$(cat "$CREDENTIALS_DIRECTORY/vault_kek_base64")" BETTER_AUTH_SECRET="$(cat "$CREDENTIALS_DIRECTORY/better_auth_secret")"; exec /usr/local/bin/pnpm wallet:sanctions --fetch'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
UMask=0077
ReadWritePaths=/opt/klick/.cache
