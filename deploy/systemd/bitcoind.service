# /etc/systemd/system/bitcoind.service — Bitcoin Core für den Wallet-Bereich
# (deploy/nodes/setup-bitcoind.sh). Nur Beobachtungs-Wallets, keine privaten
# Schlüssel auf diesem Host; RPC nur über WireGuard.
[Unit]
Description=Bitcoin Core (Klick Wallet-Knoten)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=bitcoin
Group=bitcoin
ExecStart=/usr/local/bin/bitcoind -conf=/etc/bitcoin/bitcoin.conf -datadir=/var/lib/bitcoind -printtoconsole=0
Restart=on-failure
RestartSec=10
TimeoutStopSec=600
OnFailure=klick-alert@%n.service

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
UMask=0077
ReadWritePaths=/var/lib/bitcoind
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
