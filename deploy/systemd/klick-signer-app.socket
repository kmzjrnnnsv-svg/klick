# /etc/systemd/system/klick-signer-app.socket — Signer, Socket für die App
#
# both.money (Gruppe both) reicht hier Absichten, Bestätigungen und
# Ausgabepläne weiter und darf bremsen (einfrieren, Veto, abbrechen,
# verschärfen) — einrichten und lockern geht nur über admin.sock. Klick
# (Gruppe klick) hat seit der Umstellung keinen Zugriff mehr.
[Unit]
Description=Klick — Signer (app.sock)

[Socket]
ListenStream=/run/klick-signer/app.sock
FileDescriptorName=app
Service=klick-signer.service
SocketUser=root
SocketGroup=both
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
