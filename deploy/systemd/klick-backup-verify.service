# /etc/systemd/system/klick-backup-verify.service — wöchentliche Stichprobe aus
# der Offsite-Kopie: entschlüsseln + SHA-256 (scripts/verify-backup.ts).
# Ergebnis im Audit-Log (backup.verified) und — mit BACKUP_VERIFY_ORG_ID —
# als Wirksamkeitstest an CC-BCM-03 im Mandanten 0.
[Unit]
Description=Klick — Backup-Stichprobe prüfen
After=postgresql.service network-online.target
Wants=network-online.target
OnFailure=klick-alert@%n.service

[Service]
Type=oneshot
User=klick
Group=klick
WorkingDirectory=/opt/klick/current
EnvironmentFile=/etc/klick/klick.env
EnvironmentFile=/etc/klick/backup.env
Environment=HOME=/opt/klick
LoadCredentialEncrypted=database_url:/etc/credstore.encrypted/database_url
LoadCredentialEncrypted=vault_kek_base64:/etc/credstore.encrypted/vault_kek_base64
LoadCredentialEncrypted=backup_s3_secret:/etc/credstore.encrypted/backup_s3_secret
ExecStart=/bin/sh -c 'export DATABASE_URL="$(cat "$CREDENTIALS_DIRECTORY/database_url")" VAULT_KEK_BASE64="$(cat "$CREDENTIALS_DIRECTORY/vault_kek_base64")" BACKUP_S3_SECRET_ACCESS_KEY="$(cat "$CREDENTIALS_DIRECTORY/backup_s3_secret")"; exec /usr/local/bin/pnpm exec tsx scripts/verify-backup.ts --sample 25'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
UMask=0077
# Die Apps sehen einander nicht (gleicher Server, Härtung H5)
InaccessiblePaths=-/opt/both -/etc/both -/var/lib/klick-signer -/var/backups -/var/lib/klick-backup -/root
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/opt/klick/.cache
