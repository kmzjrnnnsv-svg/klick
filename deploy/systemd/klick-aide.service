# /etc/systemd/system/klick-aide.service — Dateiintegrität prüfen (AIDE, Härtung H4)
# Jede Abweichung gegen die Datenbank beendet den Lauf mit Fehler → klick-alert@.
# Einrichten: apt install aide && aideinit && cp /var/lib/aide/aide.db.new /var/lib/aide/aide.db
[Unit]
Description=Klick — Dateiintegrität prüfen (AIDE)
OnFailure=klick-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/bin/aide --config /etc/aide/aide.conf --check
Nice=19
IOSchedulingClass=idle
# root liest fremde Dateien, schreibt nur Bericht und Datenbank-Kandidaten
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=-/var/lib/aide -/var/log/aide
