# both.money (apps/wallet) — eigene Werte, nie die von Klick.
# Lokal: nach apps/wallet/.env.local kopieren. Produktion: systemd-Credentials
# (deploy/README.md, „both.money“).

# Öffentliche Adresse (in Produktion Pflicht)
WALLET_AUTH_URL=http://localhost:3400

# Absender: Standard ist die Plattform-Adresse. Erst nach Bestätigung der
# Domain both.money im Mail-Dienst umstellen:
# WALLET_MAIL_FROM="both.money <no-reply@both.money>"
# BREVO_API_KEY=

# Anbieterkennzeichnung wie bei Klick (docs/legal/impressum.md)
# LEGAL_NAME=
# LEGAL_ADDRESS=
# LEGAL_REPRESENTATIVES=

# Jobs aus (zweiter Prozess, Tests)
# WALLET_DISABLE_JOBS=true
