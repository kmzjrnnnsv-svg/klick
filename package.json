{
	"name": "klick",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.12 <23"
	},
	"scripts": {
		"dev": "next dev",
		"build": "pnpm build:parser && next build",
		"build:parser": "tsx scripts/build-parse-worker.ts",
		"build:signer": "tsx scripts/build-signer.ts",
		"build:netz-agent": "tsx scripts/build-netz-agent.ts",
		"start": "next start",
		"dev:wallet": "next dev apps/wallet -p 3400",
		"build:wallet": "next build apps/wallet",
		"release:wallet": "tsx scripts/release-guard.ts && pnpm install --frozen-lockfile --prefer-offline && pnpm db:wallet:migrate && next build apps/wallet",
		"start:wallet": "next start apps/wallet -p 3010",
		"release": "tsx scripts/release-guard.ts && pnpm install --frozen-lockfile --prefer-offline && pnpm db:migrate && pnpm db:seed && pnpm build:parser && next build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit && tsc --noEmit -p apps/wallet",
		"preflight": "pnpm typecheck && pnpm lint && pnpm test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"audit": "pnpm audit --audit-level=high",
		"sbom": "npm_execpath= cyclonedx-npm --ignore-npm-errors --output-file sbom.cdx.json --output-format JSON",
		"db:generate": "drizzle-kit generate",
		"db:wallet:generate": "drizzle-kit generate --config apps/wallet/drizzle.config.ts",
		"db:wallet:migrate": "tsx --tsconfig apps/wallet/tsconfig.json apps/wallet/scripts/db-migrate.ts",
		"wallet:admin": "tsx --tsconfig apps/wallet/tsconfig.json apps/wallet/scripts/admin.ts",
		"wallet:recover": "tsx --tsconfig apps/wallet/tsconfig.json apps/wallet/scripts/admin.ts recover",
		"wallet:smoke:send": "tsx --tsconfig apps/wallet/tsconfig.json apps/wallet/scripts/qa/send-smoke.ts",
		"db:migrate": "tsx scripts/db-migrate.ts",
		"db:seed": "tsx db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:backup": "scripts/backup-db.sh",
		"kek:rotate": "tsx scripts/rotate-kek.ts",
		"auth:link": "tsx scripts/login-link.ts",
		"push:keys": "tsx scripts/push-keys.ts",
		"auth:recover": "tsx scripts/recover-link.ts",
		"org:network-reset": "tsx scripts/org-network-reset.ts",
		"mail:check": "tsx scripts/mail-check.ts",
		"wallet:check": "tsx --tsconfig apps/wallet/tsconfig.json apps/wallet/scripts/wallet-check.ts",
		"legal:licenses": "tsx scripts/gen-licenses.ts",
		"wallet:sanctions": "tsx --tsconfig apps/wallet/tsconfig.json apps/wallet/scripts/import-ofac-addresses.ts",
		"wallet:devchain": "tsx scripts/wallet-devchain.ts",
		"signer:dev": "tsx scripts/signer-dev.ts",
		"confirm:dev": "tsx scripts/confirm-dev.ts",
		"signer:admin": "tsx scripts/signer-admin.ts",
		"signer:recover-check": "tsx scripts/signer-recover-check.ts",
		"auth:generate": "pnpm dlx auth@latest generate --config lib/auth/server.ts --output db/auth-schema.ts -y",
		"auth:check": "pnpm dlx auth@latest check schema --config lib/auth/server.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1144.0",
		"@better-auth/drizzle-adapter": "^1.7.7",
		"@better-auth/passkey": "^1.7.7",
		"@better-auth/sso": "1.7.6",
		"@better-auth/utils": "^0.4.3",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.9.1",
		"@noble/curves": "2.4.0",
		"@noble/hashes": "2.4.0",
		"@scure/base": "2.4.0",
		"@scure/bip32": "2.4.0",
		"@scure/bip39": "2.4.0",
		"@scure/btc-signer": "2.4.1",
		"@simplewebauthn/browser": "13.3.0",
		"@simplewebauthn/server": "13.3.3",
		"better-auth": "^1.7.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.3",
		"file-type": "^22.1.1",
		"libsodium-wrappers": "^0.8.4",
		"lucide-react": "^1.49.0",
		"micro-eth-signer": "0.20.1",
		"next": "16.4.1",
		"next-intl": "^4.14.8",
		"nodemailer": "^10.1.4",
		"pg-boss": "^12.35.1",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.6.7",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.89.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@cyclonedx/cyclonedx-npm": "^6.0.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"dotenv": "^16.6.1",
		"drizzle-kit": "^0.31.11",
		"esbuild": "0.28.2",
		"happy-dom": "^21.0.4",
		"pino-pretty": "^13.1.3",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.12"
	}
}
