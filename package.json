{
	"name": "klick",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.12 <23"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"release": "pnpm install --frozen-lockfile --prefer-offline && pnpm db:migrate && pnpm db:seed && next build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit",
		"preflight": "pnpm typecheck && pnpm lint && pnpm test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"audit": "pnpm audit --audit-level=high",
		"sbom": "cyclonedx-npm --output-file sbom.cdx.json --output-format JSON",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/db-migrate.ts",
		"db:seed": "tsx db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:backup": "scripts/backup-db.sh",
		"auth:generate": "pnpm dlx auth@latest generate --config lib/auth/server.ts --output db/auth-schema.ts -y",
		"auth:check": "pnpm dlx auth@latest check schema --config lib/auth/server.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1143.0",
		"@better-auth/drizzle-adapter": "^1.7.6",
		"@better-auth/passkey": "^1.7.6",
		"@better-auth/utils": "^0.4.2",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.2.2",
		"better-auth": "^1.7.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.3",
		"file-type": "^22.1.1",
		"libsodium-wrappers": "^0.8.4",
		"lucide-react": "^1.48.0",
		"next": "16.2.4",
		"next-intl": "^4.14.8",
		"next-themes": "^0.4.6",
		"nodemailer": "^8.0.7",
		"pg-boss": "^12.35.0",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.6.7",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.74.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@cyclonedx/cyclonedx-npm": "^6.0.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.0",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv": "^16.6.1",
		"drizzle-kit": "^0.31.11",
		"happy-dom": "^20.9.0",
		"pino-pretty": "^13.1.3",
		"tailwindcss": "^4",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"vitest": "^4.1.5"
	}
}
