# ── Laufzeit ────────────────────────────────────────────────────────────────
# Nur für den Dev-Server. Nie in die Shell exportieren, bevor `pnpm build` läuft —
# Next setzt NODE_ENV=production selbst; ein exportiertes "development" lässt den
# Prerender mit der Dev-Runtime laufen und bricht den Build.
NODE_ENV=development
LOG_LEVEL=info
# KLICK_DISABLE_JOBS=true   # pg-boss nicht starten (CI/Tests)
# E2E_BASE_URL=http://localhost:3100   # Playwright gegen laufenden Server (sonst startet die Config `next start -p 3100`)

# ── Datenbank (zwei Rollen, siehe deploy/postgres/roles.sql) ────────────────
# App-Rolle: DML, kein DDL, kein BYPASSRLS
DATABASE_URL=postgres://klick_app:klick_app@localhost:5432/klick
# Migrator-Rolle: Tabellen-Owner, nur für pnpm db:migrate
DATABASE_URL_MIGRATE=postgres://klick_migrator:klick_migrator@localhost:5432/klick
# Test-DB für RLS-Integrationstests (Rolle ohne BYPASSRLS)
DATABASE_URL_TEST=postgres://klick_migrator:klick_migrator@localhost:5432/klick_test

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# openssl rand -base64 33
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Allow-List-Modus (Default): nur bekannte Konten bekommen Magic-Links.
# Self-Signup: neue Adressen bekommen einen Link und legen danach ihre Organisation an.
# AUTH_ALLOW_SIGNUP=true
# SSO je Organisation braucht keine Env: Owner registrieren ihren OIDC-IdP unter
# /einstellungen?tab=sso; Redirect-URI = BETTER_AUTH_URL + /api/auth/sso/callback/<providerId>
# Passkeys (RP-ID = Hostname ohne Port)
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Klick
# Microsoft Entra ID (optional; alle drei setzen)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# Plattform-Admin nur von diesen IPs (leer = keine Einschränkung)
# ADMIN_IP_ALLOWLIST=203.0.113.10
TRUSTED_PROXIES=127.0.0.1,::1

# ── Verschlüsselung ─────────────────────────────────────────────────────────
# KEK (32 Byte base64): openssl rand -base64 32 — umschließt die Org-DEKs.
VAULT_KEK_BASE64=
VAULT_KEK_VERSION=1
# Rotation (deploy/README.md): neuen KEK als VAULT_KEK_BASE64 + VAULT_KEK_VERSION=2,
# alten als VAULT_KEK_BASE64_V1 behalten, `pnpm kek:rotate`, dann alten entfernen.
# VAULT_KEK_BASE64_V1=

# ── Nachweise (S3-kompatibel; ab P1) ────────────────────────────────────────
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=eu-central-1
# S3_BUCKET=klick
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ── Mail (Reihenfolge: Resend → SMTP → Konsole) ─────────────────────────────
MAIL_FROM="Klick <noreply@raza.work>"
# RESEND_API_KEY=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Backups (scripts/backup-db.sh) ──────────────────────────────────────────
# BACKUP_AGE_RECIPIENT=age1…
# BACKUP_RCLONE_REMOTE=hetzner:klick-backups
# BACKUP_KEEP_DAYS=30

# ── Härtung III (optional) ──────────────────────────────────────────────────
# Malware-Scan über clamd (INSTREAM, TCP). Konfiguriert, aber nicht erreichbar → Upload abgelehnt.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# Rate-Limit je Organisation für Exporte, Nachweis-Downloads, Uploads (Anfragen/Minute, 0 = aus)
# ORG_RATE_LIMIT_PER_MIN=600
# Fehler-Tracking: GlitchTip/Sentry-Store-API (self-hosted), PII wird vor dem Versand entfernt
# GLITCHTIP_DSN=https://<public-key>@glitchtip.example.org/<project-id>
# KLICK_RELEASE=2026.10.07
# Eigene Datenbank je Enterprise-Mandant (gleiche Migrationen dort einspielen)
# ORG_DATABASE_URLS={"<orgId>":"postgres://klick_app:…@db-enterprise/klick"}
