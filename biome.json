{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.next",
			"!**/.claude",
			"!**/db/migrations",
			"!**/node_modules",
			"!**/pnpm-lock.yaml",
			"!**/*.css",
			"!**/components/ui",
			"!**/db/auth-schema.ts",
			"!**/playwright-report",
			"!**/test-results"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noLabelWithoutControl": "off"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@/db": "Kein Mandanten-Kontext: nutze withOrg()/readOrg() aus @/lib/db/with-org. Direkter Zugriff nur in lib/db, lib/auth, lib/jobs, db, scripts.",
							"@/db/index": "Kein Mandanten-Kontext: nutze withOrg()/readOrg() aus @/lib/db/with-org."
						}
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"lib/db/**",
				"lib/audit.ts",
				"lib/compliance/catalog/seed-catalog.ts",
				"lib/auth/**",
				"lib/jobs/**",
				"db/**",
				"scripts/**",
				"tests/**",
				"instrumentation.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/wallet/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@/db": "both.money hat eine eigene Datenbank — nie Klicks @/db.",
									"@/db/index": "both.money hat eine eigene Datenbank — nie Klicks @/db.",
									"@wallet/db": "Kein Org-Kontext: nutze withOrg()/readOrg() aus @wallet/lib/db/with-org. Direkt nur in apps/wallet/{lib/db,lib/auth,lib/jobs,db,scripts,tests}.",
									"@wallet/db/index": "Kein Org-Kontext: nutze withOrg()/readOrg() aus @wallet/lib/db/with-org. Direkt nur in apps/wallet/{lib/db,lib/auth,lib/jobs,db,scripts,tests}."
								},
								"patterns": [
									{
										"group": [
											"@/**",
											"!@/lib/wallet/core/**",
											"!@/lib/wallet/rpc/**",
											"!@/lib/wallet/sync/**",
											"!@/lib/wallet-link/**",
											"!@/lib/http/**",
											"!@/lib/wallet/model",
											"!@/lib/wallet/display",
											"!@/lib/wallet/intro",
											"!@/lib/wallet/ofac",
											"!@/lib/wallet/pair-names",
											"!@/lib/wallet/prices",
											"!@/lib/wallet/reconcile-source",
											"!@/lib/wallet/return-path",
											"!@/lib/wallet/screening",
											"!@/lib/wallet/payouts/plan",
											"!@/lib/wallet/signer/types",
											"!@/db/columns",
											"!@/db/rls",
											"!@/lib/mail/send",
											"!@/lib/mail/address",
											"!@/lib/mail/html",
											"!@/lib/legal/entity",
											"!@/lib/audit-hash",
											"!@/lib/auth/session-rules",
											"!@/lib/auth/endpoint-policy",
											"!@/lib/crypto/envelope",
											"!@/lib/crypto/kms",
											"!@/lib/crypto/fields",
											"!@/components/ui/**",
											"!@/lib/utils",
											"!@/lib/log",
											"!@/lib/rate-limit",
											"!@/lib/observability/glitchtip",
											"!@/signer/client",
											"!@/styles/**",
											"!@/lib/actions/safe"
										],
										"message": "both.money nutzt aus Klick nur geteilte, reine Module (Liste in tests/app-boundaries.test.ts) — nie Datenbank, Auth oder Fachcode."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"apps/wallet/lib/db/**",
				"apps/wallet/lib/auth/**",
				"apps/wallet/lib/jobs/**",
				"apps/wallet/lib/audit.ts",
				"apps/wallet/db/**",
				"apps/wallet/instrumentation.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@/db": "both.money hat eine eigene Datenbank — nie Klicks @/db.",
									"@/db/index": "both.money hat eine eigene Datenbank — nie Klicks @/db."
								},
								"patterns": [
									{
										"group": [
											"@/**",
											"!@/lib/wallet/core/**",
											"!@/lib/wallet/rpc/**",
											"!@/lib/wallet/sync/**",
											"!@/lib/wallet-link/**",
											"!@/lib/http/**",
											"!@/lib/wallet/model",
											"!@/lib/wallet/display",
											"!@/lib/wallet/intro",
											"!@/lib/wallet/ofac",
											"!@/lib/wallet/pair-names",
											"!@/lib/wallet/prices",
											"!@/lib/wallet/reconcile-source",
											"!@/lib/wallet/return-path",
											"!@/lib/wallet/screening",
											"!@/lib/wallet/payouts/plan",
											"!@/lib/wallet/signer/types",
											"!@/db/columns",
											"!@/db/rls",
											"!@/lib/mail/send",
											"!@/lib/mail/address",
											"!@/lib/mail/html",
											"!@/lib/legal/entity",
											"!@/lib/audit-hash",
											"!@/lib/auth/session-rules",
											"!@/lib/auth/endpoint-policy",
											"!@/lib/crypto/envelope",
											"!@/lib/crypto/kms",
											"!@/lib/crypto/fields",
											"!@/components/ui/**",
											"!@/lib/utils",
											"!@/lib/log",
											"!@/lib/rate-limit",
											"!@/lib/observability/glitchtip",
											"!@/signer/client",
											"!@/styles/**",
											"!@/lib/actions/safe"
										],
										"message": "both.money nutzt aus Klick nur geteilte, reine Module (Liste in tests/app-boundaries.test.ts) — nie Datenbank, Auth oder Fachcode."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/wallet/scripts/**", "apps/wallet/tests/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@/db": "both.money hat eine eigene Datenbank — nie Klicks @/db.",
									"@/db/index": "both.money hat eine eigene Datenbank — nie Klicks @/db."
								},
								"patterns": [
									{
										"group": [
											"@/**",
											"!@/lib/wallet/core/**",
											"!@/lib/wallet/rpc/**",
											"!@/lib/wallet/sync/**",
											"!@/lib/wallet-link/**",
											"!@/lib/http/**",
											"!@/lib/wallet/model",
											"!@/lib/wallet/display",
											"!@/lib/wallet/intro",
											"!@/lib/wallet/ofac",
											"!@/lib/wallet/pair-names",
											"!@/lib/wallet/prices",
											"!@/lib/wallet/reconcile-source",
											"!@/lib/wallet/return-path",
											"!@/lib/wallet/screening",
											"!@/lib/wallet/payouts/plan",
											"!@/lib/wallet/signer/types",
											"!@/db/columns",
											"!@/db/rls",
											"!@/lib/mail/send",
											"!@/lib/mail/address",
											"!@/lib/mail/html",
											"!@/lib/legal/entity",
											"!@/lib/audit-hash",
											"!@/lib/auth/session-rules",
											"!@/lib/auth/endpoint-policy",
											"!@/lib/crypto/envelope",
											"!@/lib/crypto/kms",
											"!@/lib/crypto/fields",
											"!@/components/ui/**",
											"!@/lib/utils",
											"!@/lib/log",
											"!@/lib/rate-limit",
											"!@/lib/observability/glitchtip",
											"!@/signer/client",
											"!@/styles/**",
											"!@/lib/actions/safe",
											"!@/signer/**",
											"!@/scripts/devchain/**",
											"!@/scripts/qa/**",
											"!@/tests/helpers/**"
										],
										"message": "both.money nutzt aus Klick nur geteilte, reine Module (Liste in tests/app-boundaries.test.ts) — nie Datenbank, Auth oder Fachcode."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
